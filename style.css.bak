:root {
  --bg-primary: #0a0a0f;
  --bg-secondary: #12121a;
  --bg-card: #16161f;
  --bg-card-hover: #1c1c28;
  --border: #2a2a3a;
  --border-hover: #3a3a5a;
  --text-primary: #eeeef0;
  --text-secondary: #9898a8;
  --text-muted: #68687a;
  --accent: #e50914; /* Netflix/Plex Red */
  --accent-glow: rgba(229, 9, 20, 0.4);
  --green: #00d26a;
  --green-neon: #39ff14;
  --blue: #0984e3;
  --purple: #a29bfe;
  
  --nav-height: 65px; /* Height of bottom nav */
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  outline: none;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  margin: 0;
  padding: 0;
  margin-left: 300px; /* Default desktop sidebar width */
  padding-top: 80px;
  overflow-x: hidden;
  font-size: 16px; 
  -webkit-text-size-adjust: 100%;
}

input, select, textarea, button { font-size: 16px !important; }

/* --- DESKTOP SIDEBAR --- */
header {
  background: rgba(10, 10, 15, 0.98);
  padding: 30px 20px;
  position: fixed;
  top: 0;
  left: 0;
  width: 300px;
  height: 100vh;
  z-index: 1000;
  border-right: 1px solid var(--border);
  overflow-y: auto;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

h1 {
  font-size: 2.2rem;
  font-weight: 800;
  background: linear-gradient(135deg, #fff 0%, #888 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Tabs & Links */
.tabs { display: flex; flex-direction: column; gap: 8px; width: 100%; }
.tab-btn {
  padding: 12px 20px;
  background: transparent;
  color: var(--text-secondary);
  border: none;
  cursor: pointer;
  font-size: 1rem;
  transition: all 0.3s ease;
  border-radius: 10px;
  width: 100%;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 10px;
}
.tab-btn.active {
  background: var(--accent);
  color: white;
  box-shadow: 0 4px 15px var(--accent-glow);
}
.tab-badge {
  background: white;
  color: var(--accent);
  font-size: 0.75rem;
  padding: 2px 6px;
  border-radius: 6px;
  font-weight: 900;
}

/* Sidebar Toggle */
.sidebar-toggle-btn { display: none; } /* Hidden on desktop default */

/* --- SEARCH --- */
.search-container { width: 100%; position: relative; }
.search-input {
  width: 100%;
  padding: 12px 14px 12px 40px;
  border-radius: 10px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  color: var(--text-primary);
}
.search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }


/* --- DESKTOP CONTROLS BAR (STICKY) --- */
.controls-bar {
  display: flex;
  gap: 12px;
  padding: 15px;
  padding-left: 320px; /* +20px buffer */
  background: rgba(10, 10, 15, 0.95);
  border-bottom: 1px solid var(--border);
  align-items: center;
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 900;
  backdrop-filter: blur(10px);
}

.control-select, .control-btn {
  padding: 10px 15px;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  color: var(--text-primary);
  border-radius: 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
}
.control-btn:hover { border-color: var(--accent); color: var(--accent); }

/* --- GRID & CARDS --- */
.view-section { display: none; animation: fadeIn 0.4s ease; }
.view-section.active { display: block; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.movie-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 25px;
  margin-top: 10px;
}

.movie-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  display: flex; flex-direction: column;
}

.poster-wrapper { position: relative; aspect-ratio: 2/3; background: #000; overflow: hidden; }
.poster-img { width: 100%; height: 100%; object-fit: cover; }
.card-content { padding: 12px; display: flex; flex-direction: column; flex-grow: 1; }
.movie-title { font-size: 1rem; font-weight: 700; margin-bottom: 4px; line-height: 1.3; }
.movie-year { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 8px; }

/* Badges */
.rating-badge { position: absolute; top:8px; right:8px; background:rgba(0,0,0,0.8); color:var(--green); padding:4px 8px; border-radius:6px; font-size:0.8rem; font-weight:bold; backdrop-filter:blur(4px); }
.priority-badge { position: absolute; top:8px; left:8px; background:rgba(229,9,20,0.9); color:white; padding:4px 8px; border-radius:6px; font-size:0.75rem; font-weight:bold; }
.library-item { border: 2px solid var(--green-neon); box-shadow: 0 0 15px rgba(57,255,20,0.2); }

/* Buttons inside cards */
.btn-wrapper { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
.btn-card {
  width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--bg-secondary); color: var(--text-secondary); cursor: pointer;
  font-weight: 600; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 6px;
}
.btn-request:hover { background: var(--accent); color: white; border-color: var(--accent); }

/* Stats */
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin: 20px 0; }
.stat-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 15px; text-align: center; }
.stat-value { font-size: 1.8rem; font-weight: 800; color: var(--accent); }
.stat-label { font-size: 0.85rem; color: var(--text-secondary); }

/* Mobile Tweaks (Original Simple Version) */
@media (max-width: 768px) {
  .controls-bar {
      padding-left: 15px;
      flex-wrap: wrap;
      gap: 8px;
  }
  .sidebar-toggle-btn { display: block; }
  main { margin-left: 0 !important; }
  header { transform: translateX(-100%); transition: transform 0.3s ease; }
  body.sidebar-open header { transform: translateX(0); }
  
  /* Touch Targets - Min 44px */
  .control-btn, .control-select, .sidebar-toggle-btn, .tab-btn, #search {
    min-height: 48px;
    font-size: 16px;
  }
  .modal-content {
        flex-direction: column;
        padding: 20px;
        margin-top: -60px;
  }
  .modal-poster {
        width: 140px; 
        margin: 0 auto 20px auto; 
        box-shadow: 0 5px 15px rgba(0,0,0,0.5);
  }
  .modal-info { text-align: center; }
}

/* --- CONTEXT MENU --- */
.context-menu {
  display: none;
  position: absolute;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  z-index: 10000;
  min-width: 180px;
  padding: 5px 0;
}
.context-menu.active { display: block; }
.context-menu-item {
  padding: 10px 15px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text-primary);
  font-size: 0.9rem;
  transition: background 0.2s;
}
.context-menu-item:hover { background: var(--bg-card-hover); color: var(--accent); }
.context-menu-separator { height: 1px; background: var(--border); margin: 5px 0; }
